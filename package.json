{
  "name": "vaani-linux",
  "productName": "Vaani",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && NODE_ENV=development tsx server.ts",
    "build": "node scripts/build.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "description": "Local-first multi-provider Linux voice assistant"
}
