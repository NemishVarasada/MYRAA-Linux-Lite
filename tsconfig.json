{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "server_paths.ts",
    "server_memory.ts",
    "provider_config.ts",
    "src/providers/**/*.ts",
    "src/local/**/*.ts"
  ],
  "exclude": ["dist", "release", "node_modules"]
}
